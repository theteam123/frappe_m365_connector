<?xml version="1.0" encoding="UTF-8"?>
<!--
  Outlook add-in manifest — "Send to ERP".
  Adds a button on the message-read surface that opens the task pane to file the
  email and/or its attachments into ERP. All URLs are served same-origin from
  the ERP site so the task pane and the API share an origin.

  NOTE: This manifest targets PRODUCTION (ops.sgcloud.com.au). For staging tests
  use a copy with the host swapped to staging.sgcapp.com.au and a different Id.
-->
<OfficeApp
	xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
	xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
	xsi:type="MailApp">

	<Id>0a475e70-634a-460b-9f32-cfc8a5fe6759</Id>
	<Version>1.0.0.0</Version>
	<ProviderName>TierneyMorris Pty Ltd</ProviderName>
	<DefaultLocale>en-US</DefaultLocale>
	<DisplayName DefaultValue="Send to ERP (Staging)" />
	<Description DefaultValue="File this email and its attachments into an ERP record." />
	<IconUrl DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/icon-64.png" />
	<HighResolutionIconUrl DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/icon-128.png" />
	<SupportUrl DefaultValue="https://staging.sgcapp.com.au/app" />

	<Hosts>
		<Host Name="Mailbox" />
	</Hosts>

	<Requirements>
		<Sets>
			<Set Name="Mailbox" MinVersion="1.5" />
		</Sets>
	</Requirements>

	<FormSettings>
		<Form xsi:type="ItemRead">
			<DesktopSettings>
				<SourceLocation DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/taskpane.html" />
				<RequestedHeight>450</RequestedHeight>
			</DesktopSettings>
		</Form>
	</FormSettings>

	<Permissions>ReadWriteItem</Permissions>

	<Rule xsi:type="RuleCollection" Mode="Or">
		<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
	</Rule>

	<DisableEntityHighlighting>false</DisableEntityHighlighting>

	<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
		<Requirements>
			<bt:Sets DefaultMinVersion="1.5">
				<bt:Set Name="Mailbox" />
			</bt:Sets>
		</Requirements>
		<Hosts>
			<Host xsi:type="MailHost">
				<DesktopFormFactor>
					<ExtensionPoint xsi:type="MessageReadCommandSurface">
						<OfficeTab id="TabDefault">
							<Group id="sgcErpGroup">
								<Label resid="groupLabel" />
								<Control xsi:type="Button" id="sendToErpButton">
									<Label resid="buttonLabel" />
									<Supertip>
										<Title resid="buttonLabel" />
										<Description resid="buttonTip" />
									</Supertip>
									<Icon>
										<bt:Image size="16" resid="icon16" />
										<bt:Image size="32" resid="icon32" />
										<bt:Image size="80" resid="icon80" />
									</Icon>
									<Action xsi:type="ShowTaskpane">
										<SourceLocation resid="taskpaneUrl" />
									</Action>
								</Control>
							</Group>
						</OfficeTab>
					</ExtensionPoint>
				</DesktopFormFactor>
			</Host>
		</Hosts>
		<Resources>
			<bt:Images>
				<bt:Image id="icon16" DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/icon-16.png" />
				<bt:Image id="icon32" DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/icon-32.png" />
				<bt:Image id="icon80" DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/icon-80.png" />
			</bt:Images>
			<bt:Urls>
				<bt:Url id="taskpaneUrl" DefaultValue="https://staging.sgcapp.com.au/assets/m365email/sendtoerp/taskpane.html" />
			</bt:Urls>
			<bt:ShortStrings>
				<bt:String id="groupLabel" DefaultValue="ERP" />
				<bt:String id="buttonLabel" DefaultValue="Send to ERP (Staging)" />
				<bt:String id="buttonTip" DefaultValue="File this email and its attachments into an ERP record." />
			</bt:ShortStrings>
		</Resources>
	</VersionOverrides>
</OfficeApp>
