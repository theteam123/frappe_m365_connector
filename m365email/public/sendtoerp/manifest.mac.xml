<?xml version="1.0" encoding="UTF-8"?>
<!--
  Outlook add-in manifest: "Send to ERP for Mac" (add-in only XML).
  Outlook for Mac cannot run the unified (JSON) package in sendtoerp-prod.zip.
  It only gets a copy that Microsoft converts, and that copy is greyed out in
  shared mailboxes. This manifest declares SupportsSharedFolders directly, so
  Mac users can use Send to ERP in shared mailboxes such as Recruitment.
  Upload it in M365 admin centre > Integrated apps > Upload custom apps >
  Office Add-in, and assign it to Mac users only. Windows and web users already
  have the unified package. It uses its own Id, so it never clashes with that
  package. The task pane, sign-in and API are the same as manifest.xml.
  Keep it in step with manifest.xml whenever the button or URLs change.
-->
<OfficeApp
	xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
	xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
	xsi:type="MailApp">

	<Id>881ad34d-2e90-430e-a96d-f15db2e1ec4f</Id>
	<Version>1.0.0.0</Version>
	<ProviderName>TierneyMorris Pty Ltd</ProviderName>
	<DefaultLocale>en-US</DefaultLocale>
	<DisplayName DefaultValue="Send to ERP for Mac" />
	<Description DefaultValue="File this email and its attachments into an ERP record." />
	<IconUrl DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-64.png" />
	<HighResolutionIconUrl DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-128.png" />
	<SupportUrl DefaultValue="https://ops.sgcloud.com.au/app" />

	<Hosts>
		<Host Name="Mailbox" />
	</Hosts>

	<Requirements>
		<Sets>
			<Set Name="Mailbox" MinVersion="1.5" />
		</Sets>
	</Requirements>

	<FormSettings>
		<Form xsi:type="ItemRead">
			<DesktopSettings>
				<SourceLocation DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/taskpane.html" />
				<RequestedHeight>450</RequestedHeight>
			</DesktopSettings>
		</Form>
	</FormSettings>

	<Permissions>ReadWriteItem</Permissions>

	<Rule xsi:type="RuleCollection" Mode="Or">
		<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
	</Rule>

	<DisableEntityHighlighting>false</DisableEntityHighlighting>

	<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
		<Requirements>
			<bt:Sets DefaultMinVersion="1.5">
				<bt:Set Name="Mailbox" />
			</bt:Sets>
		</Requirements>
		<Hosts>
			<Host xsi:type="MailHost">
				<DesktopFormFactor>
					<ExtensionPoint xsi:type="MessageReadCommandSurface">
						<OfficeTab id="TabDefault">
							<Group id="sgcErpGroup">
								<Label resid="groupLabel" />
								<Control xsi:type="Button" id="sendToErpButton">
									<Label resid="buttonLabel" />
									<Supertip>
										<Title resid="buttonLabel" />
										<Description resid="buttonTip" />
									</Supertip>
									<Icon>
										<bt:Image size="16" resid="icon16" />
										<bt:Image size="32" resid="icon32" />
										<bt:Image size="80" resid="icon80" />
									</Icon>
									<Action xsi:type="ShowTaskpane">
										<SourceLocation resid="taskpaneUrl" />
									</Action>
								</Control>
							</Group>
						</OfficeTab>
					</ExtensionPoint>
				</DesktopFormFactor>
			</Host>
		</Hosts>
		<Resources>
			<bt:Images>
				<bt:Image id="icon16" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-16.png" />
				<bt:Image id="icon32" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-32.png" />
				<bt:Image id="icon80" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-80.png" />
			</bt:Images>
			<bt:Urls>
				<bt:Url id="taskpaneUrl" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/taskpane.html" />
			</bt:Urls>
			<bt:ShortStrings>
				<bt:String id="groupLabel" DefaultValue="ERP" />
				<bt:String id="buttonLabel" DefaultValue="Send to ERP" />
				<bt:String id="buttonTip" DefaultValue="File this email and its attachments into an ERP record." />
			</bt:ShortStrings>
		</Resources>
		<!-- Mail 1.1 overrides: same button, plus SupportsSharedFolders so it works in shared mailboxes. -->
		<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
			<Requirements>
				<bt:Sets DefaultMinVersion="1.5">
					<bt:Set Name="Mailbox" />
				</bt:Sets>
			</Requirements>
			<Hosts>
				<Host xsi:type="MailHost">
					<DesktopFormFactor>
						<SupportsSharedFolders>true</SupportsSharedFolders>
						<ExtensionPoint xsi:type="MessageReadCommandSurface">
							<OfficeTab id="TabDefault">
								<Group id="sgcErpGroup">
									<Label resid="groupLabel" />
									<Control xsi:type="Button" id="sendToErpButton">
										<Label resid="buttonLabel" />
										<Supertip>
											<Title resid="buttonLabel" />
											<Description resid="buttonTip" />
										</Supertip>
										<Icon>
											<bt:Image size="16" resid="icon16" />
											<bt:Image size="32" resid="icon32" />
											<bt:Image size="80" resid="icon80" />
										</Icon>
										<Action xsi:type="ShowTaskpane">
											<SourceLocation resid="taskpaneUrl" />
										</Action>
									</Control>
								</Group>
							</OfficeTab>
						</ExtensionPoint>
					</DesktopFormFactor>
				</Host>
			</Hosts>
			<Resources>
				<bt:Images>
					<bt:Image id="icon16" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-16.png" />
					<bt:Image id="icon32" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-32.png" />
					<bt:Image id="icon80" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/icon-80.png" />
				</bt:Images>
				<bt:Urls>
					<bt:Url id="taskpaneUrl" DefaultValue="https://ops.sgcloud.com.au/assets/m365email/sendtoerp/taskpane.html" />
				</bt:Urls>
				<bt:ShortStrings>
					<bt:String id="groupLabel" DefaultValue="ERP" />
					<bt:String id="buttonLabel" DefaultValue="Send to ERP" />
					<bt:String id="buttonTip" DefaultValue="File this email and its attachments into an ERP record." />
				</bt:ShortStrings>
			</Resources>
		</VersionOverrides>
	</VersionOverrides>
</OfficeApp>
